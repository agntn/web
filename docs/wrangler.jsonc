{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-web",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://web.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-web",
      "database_id": "0ba10a5b-f3c6-4792-a2f7-34c62339a3d3"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8285cbe91449494ab97650ffb22f7bc8"
    }
  ],
  "cache": {
    "enabled": true
  },
  "routes": [{ "pattern": "web.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
