{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@agntn/web": ["./src/index.ts"],
      "@agntn/web/tools": ["./src/tools.ts"]
    },
    "outDir": "./dist-extensions",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["extensions/omp/**/*.ts", "extensions/pi/**/*.ts", "src/tui.ts"],
  "exclude": ["node_modules", "dist"]
}
