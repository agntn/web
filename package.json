{
  "name": "@agntn/web",
  "version": "0.9.0",
  "description": "Unified web search and read provider for agents and CLI.",
  "keywords": [
    "agents",
    "cli",
    "pi-extension",
    "pi-package",
    "provider",
    "search",
    "typescript",
    "unified",
    "web-search"
  ],
  "homepage": "https://web.agntn.dev",
  "bugs": "https://github.com/agntn/web/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/web.git"
  },
  "bin": {
    "web": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi",
    "src/tool-titles.ts",
    "src/tui.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "import": "./dist/tools.mjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.mts",
      "import": "./dist/providers/index.mjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.mts",
      "import": "./dist/providers/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:run": "vp test --run",
    "prepack": "obuild",
    "lint": "obuild && vp check",
    "lint:fix": "obuild && vp check --fix",
    "docs": "vp -C docs run dev",
    "docs:build": "vp -C docs run build"
  },
  "dependencies": {
    "@agntn/hashes": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps",
    "string-width": "catalog:deps",
    "zod": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/omptype": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "jiti": "catalog:dev",
    "obuild": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1 <2",
    "@earendil-works/pi-tui": ">=0.86.1 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "omp": {
    "extensions": [
      "./extensions/omp/web.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/*.ts"
    ],
    "image": "https://web.agntn.dev/image.png"
  }
}
